{
  "expo": {
    "name": "Armenian Prayers",
    "slug": "armenian-prayers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F1F1F",
      "statusBar": {
        "style": "dark"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bottlespeaker.armenianprayers",
      "usePushNotificationsEmulator": false,
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0b11ad70-094b-4cc3-aade-fdb5a22bd2f0"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "ios": {
            "capable": false
          }
        }
      ]
    ]
  }
}
